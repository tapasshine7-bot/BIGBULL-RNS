// Deploy with:
//   1. wrangler d1 create bigbull-rns-db      (note the returned database_id)
//   2. Update the "database_id" below with the value from step 1.
//   3. wrangler d1 execute bigbull-rns-db --file=schema.sql
//   4. wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigbull-rns-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "bigbull-rns-db",
      "database_id": "c7c415d7-ec40-42c7-aae7-9b1168030fea"
    }
  ]
}
