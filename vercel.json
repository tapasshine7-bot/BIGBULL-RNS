{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/rversed-bigbull run build",
  "outputDirectory": "artifacts/rversed-bigbull/dist/public",
  "rewrites": [
    { "source": "/gateway", "destination": "/index.html" },
    { "source": "/vip", "destination": "/index.html" },
    { "source": "/bio", "destination": "/index.html" },
    { "source": "/activity", "destination": "/index.html" }
  ]
}